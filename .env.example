# ---------------------------------------------------------------------------
# Avenza configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Database. SQLite works out of the box. For Postgres:
# DATABASE_URL=postgresql+psycopg://avenza:avenza@localhost:5432/avenza
DATABASE_URL=sqlite:///./avenza.db

# Bank. mock = local simulated bank (clearly labelled).
# sandbox = Xtradot Bank, the Forge 2026 sandbox (see docs/FORGE.md).
BANK_MODE=mock

# Speech providers: mock | yarn | deepgram | sahara | ai
# "ai" uses the vendored avenza_ai provider registry (Deepgram / YarnGPT /
# Sahara streaming) and falls back to mock when credentials are missing.
STT_PROVIDER=mock
TTS_PROVIDER=mock
# For the live demo, in .env: STT_PROVIDER=ai (streaming Deepgram/YarnGPT/Sahara)
# and TTS_PROVIDER=yarngpt. Keys go in .env only, never in this file.

# The demo client can send browser speech-recognition text or typed text.
# Set to false when a real STT provider is configured.
ALLOW_TEXT_UTTERANCE=true

# YarnGPT (see vendor docs; endpoint formats marked CONFIRM in the adapter)
YARN_API_KEY=
YARN_ASR_URL=
YARN_TTS_URL=
YARN_TTS_VOICE=

# Deepgram (second STT provider)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Sahara v2.5 (organisers' sandbox; placeholders marked CONFIRM)
SAHARA_API_KEY=
SAHARA_ASR_URL=

# LLM: OpenAI-compatible chat endpoint. Used ONLY for intent classification.
# If disabled or unavailable, the deterministic keyword fallback is used.
LLM_ENABLED=false
# openai (any OpenAI-compatible API, e.g. Groq) | huawei-maas (Forge cluster:
# uses GATEWAY_KEY as the "apikey" header, glm-5.2, thinking off).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Never commit a real key. Put it in .env (gitignored), not here.
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=1.5

# --- AI/ML layer (vendored avenza_ai package) -----------------------------
# The backend parser remains the only amount authority. The AI layer can
# classify intent, cross-check a number, render a read-back or transcribe audio;
# it can never approve a transfer.
AI_ENABLED=true
AI_INTENT_ENABLED=true
# Safety cross-check (on by default): if the AI parser hears a different amount
# or a foreign currency, the customer is asked again. It never replaces the
# amount, and it stays silent when it simply cannot read the phrase.
AI_AMOUNT_CROSSCHECK=true
# Opt-in AI read-back template (bank-verified name, digit spelling on 13/30 etc).
AI_READBACK=false
# Use the AI time-phrase parser for "in October", "this year", "5 days ago".
AI_HISTORY=true
# Languages whose number words / intent words are enabled. Only "en" is
# currently verified; add yo/ha/ig only after the language test passes.
AI_LANGUAGES=en
AI_DEFAULT_LANGUAGE=en
AI_PROVIDER_CHOICE=reports/provider_choice.json
AI_STT_TIMEOUT_S=8
# Stream audio to the STT provider while the customer speaks (partials, lower
# latency). Set false to transcribe the whole utterance after it ends.
STT_STREAMING=true
TTS_TIMEOUT_S=6
TTS_CACHE_SIZE=256

# Background pass that expires abandoned drafts and resolves unknown bank
# outcomes even when the customer has disconnected.
RECONCILE_INTERVAL_S=5
RECONCILE_STALE_S=20
RECONCILE_RESUBMIT_S=60

# Per-stage latency (JSON lines). Summarise with scripts/latency_report.py.
LATENCY_LOG=reports/latency.jsonl

# WebAuthn. RP ID must be the registrable domain (localhost for local dev).
# Origin must match exactly what the browser shows, including scheme and port.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Avenza
WEBAUTHN_ORIGIN=http://localhost:8000

# Transfer rules
MAX_AMOUNT_KOBO=100000000
LARGE_AMOUNT_THRESHOLD_KOBO=5000000
NEW_RECIPIENT_HOLD_S=10
DUPLICATE_WINDOW_HOURS=24
DRAFT_TTL_S=120
READBACK_TTL_S=90
APPROVAL_TTL_S=60
SESSION_TTL_S=1800

# Developer/demo switches. Never enable ALLOW_DEV_APPROVAL in production:
# it bypasses the fingerprint and exists only for automated tests.
DEV_TOOLS=true
ALLOW_DEV_APPROVAL=false
# Protects /audit/* and /dev/bank/* from other devices. Without it those routes
# only answer requests from this machine (localhost). Set a long random value
# for shared demos and send it as the X-Admin-Token header.
ADMIN_TOKEN=

# --- Forge 2026 platform (see docs/FORGE.md) ------------------------------
# BANK_MODE=sandbox uses the Xtradot Bank sandbox. It only answers from inside
# your Kubernetes namespace; off the cluster, run the local simulator:
#   python -m avenza.bank.xtradot_sim      (then the values below)
# The team key: on the cluster it is injected as GATEWAY_KEY from the
# huawei-gateway secret. Locally, the simulator accepts "dev-team-key".
GATEWAY_KEY=
SANDBOX_BASE_URL=http://bank-api.ingress-apisix.svc.cluster.local/v1
# The customer's debit account when none is set per user (guide §5.4:
# Babatunde Olumide Adeyemi, tier 3, ₦5,000,000).
SANDBOX_SOURCE_ACCOUNT=0123456790
SANDBOX_TIMEOUT_S=12
# Interbank settles in ~5 s: wait this long for the final status before
# answering "pending".
SANDBOX_SETTLE_WAIT_S=6
# Demo only, never production: force an outcome (successful|failed|pending|timeout|reversed).
SANDBOX_TEST_OUTCOME=
# Printed once by scripts/register_webhook.py.
FORGE_WEBHOOK_SECRET=
# Bank + MaaS share 60 requests a minute per team.
GATEWAY_REQUESTS_PER_MIN=55

# Static PWA directory (relative to the project root)
WEB_DIR=web
