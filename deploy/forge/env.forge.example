# Copy to deploy/forge/.env.forge (gitignored) and fill in. deploy.sh turns
# these into the "avenza-secrets" Kubernetes secret. Values here override the
# ConfigMap in app.yaml. Never commit real values.
#
# GATEWAY_KEY is NOT here: the platform team already put it in your namespace
# as the huawei-gateway secret.

# --- Speech-to-text (STT_PROVIDER=ai is set in app.yaml) -------------------
# Which provider handles which language; "a|b" means use b if a refuses or fails.
# Code-switched speech arrives in the session's language (usually "en"), so send
# en and pcm to Sahara (Intron), with YarnGPT as the fallback: Intron allows only
# 3 connections a minute, and each spoken turn is one connection.
AI_STT_CHOICE=en=sahara|yarngpt,pcm=sahara|yarngpt
# Intron Sahara streaming. Default: wss://infer.voice.intron.io/stt/v1/stream
SAHARA_API_KEY=
SAHARA_ASR_URL=
# Intron language codes if they differ from ours (only "en" is confirmed), e.g. pcm=en
SAHARA_LANG_MAP=
DEEPGRAM_API_KEY=
# YarnGPT live transcription. Default: wss://api.yarngpt.ai/api/v1/asr/stream
# (only used when AI_STT_CHOICE sends a language to "yarngpt").
YARNGPT_ASR_WS_URL=

# --- Text-to-speech (TTS_PROVIDER=yarngpt is set in app.yaml) ---------------
# The same YarnGPT key is used for TTS and live transcription.
YARNGPT_API_KEY=
# Real-time route that returns audio in the response. Leave empty for the default:
# https://api.yarngpt.ai/api/v1/streaming/conversation
YARNGPT_TTS_URL=
# Optional voice id from GET /api/v1/voices (e.g. "umar"); empty = YarnGPT's default.
YARNGPT_DEFAULT_VOICE=

# --- LLM: Groq for testing (delete these lines on Demo Day -> Huawei MaaS) ---
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=1.5
LLM_API_KEY=

# --- Platform ---------------------------------------------------------------
# A long random string (openssl rand -hex 24). Needed for /audit and /dev/bank/*.
ADMIN_TOKEN=
# Printed once by scripts/register_webhook.py.
FORGE_WEBHOOK_SECRET=
