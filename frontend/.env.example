# mock = built-in scenarios, no backend needed. live = the real Avenza backend.
VITE_BACKEND_MODE=live

# REST base URL of the backend. Leave empty to use the same origin as the app (reverse proxy / `npm run dev` proxy).
VITE_API_BASE_URL=https://team18.xtradot.co

# Optional. Defaults to VITE_API_BASE_URL with ws(s):// and /ws appended.
VITE_WS_URL=

# Mock mode only.
VITE_MOCK_SCENARIO=happy_path

# Dev panel (5 taps on the wordmark). Keep false in production.
VITE_DEV_PANEL=false
